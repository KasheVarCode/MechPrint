---
import ThemeSwitcher from './ThemeSwitcher.astro';
import { ru as i18n } from '../i18n/ru';
---

<header class="topbar">
	<div class="container topbar__inner">
		<div class="brand">
			<div class="brand__name">{i18n.brand.name}</div>
		</div>
		<ThemeSwitcher />
	</div>
</header>

<main>
	<section class="hero">
		<div class="hero__bg" aria-hidden="true">
			<video class="hero__video" autoplay muted loop playsinline preload="metadata">
				<source src="/video/hero.webm" type="video/webm" />
				<source src="/video/hero.mp4" type="video/mp4" />
			</video>
			<div class="hero__overlay"></div>
		</div>

		<div class="container hero__grid">
			<div class="stack">
				<h1 class="hero__title">{i18n.hero.title}</h1>
				<p class="muted">{i18n.hero.subtitle}</p>
				<div class="hero__actions">
					<a class="btn btn-primary" href="#" data-subdomain-link="app">
						{i18n.cta.cabinet}
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="container section" id="contact">
		<div class="card card--padded">
			<strong>{i18n.contact.title}</strong>
			<div class="muted" style="margin-top: 8px;">
				{i18n.contact.phoneLabel}: <a href="tel:+70000000000">+7 (000) 000-00-00</a>
			</div>
			<div class="muted" style="margin-top: 6px;">{i18n.contact.placeholder}</div>
		</div>
	</section>
</main>
