---
import NlText from './NlText.astro';
import CabinetInfoSection from './CabinetInfoSection.astro';
import B2BInfoSection from './B2BInfoSection.astro';
import ApiIntegrationSection from './ApiIntegrationSection.astro';
import PricingSection from './PricingSection.astro';
import ContactSection from './ContactSection.astro';
import { ru as i18n } from '../i18n/ru';
---

<main>
	<section class="hero">
		<div class="hero__bg" aria-hidden="true">
			<video class="hero__video" autoplay muted loop playsinline preload="metadata">
				<source src="/video/hero.webm" type="video/webm" />
				<source src="/video/hero.mp4" type="video/mp4" />
			</video>
			<div class="hero__overlay"></div>
		</div>

		<div class="container hero__grid">
			<div class="hero__content stack">
				<h1 class="hero__title">
					<span class="hero__titleLine hero__titleLine--primary">{i18n.hero.title1}</span>
					<span class="hero__titleLine">{i18n.hero.title2}</span>
				</h1>
				<h2 class="muted hero__subtitle"><NlText text={i18n.hero.subtitle} /></h2>
				<div class="hero__actions">
					<a
						class="btn btn-primary"
						href="https://app.mechprint.ru/"
					>
						{i18n.cta.cabinet}
					</a>
				</div>
				<ul class="checkList hero__leadList" aria-label="Возможности">
					{i18n.hero.points.map((t) => (
						<li class="checkList__item">
							<span class="checkList__icon" aria-hidden="true">✓</span>
							<span class="muted checkList__text"><NlText text={t} /></span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<CabinetInfoSection />
	<B2BInfoSection />
	<PricingSection />
	<ApiIntegrationSection />
	<ContactSection />
</main>
