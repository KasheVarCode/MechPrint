---
import { ru as i18n } from '../i18n/ru';

const year = new Date().getFullYear();
---

<footer class="siteFooter">
	<div class="container siteFooter__bottom" aria-label="Credits">
		<span class="muted">{i18n.footer.created}</span>
		<a class="siteFooter__link" href="https://kashevarcode.com" target="_blank" rel="noreferrer">
			{i18n.footer.brand}
		</a>
		<span class="muted siteFooter__sep">•</span>
		<span class="muted">{year}</span>
		<span class="muted siteFooter__sep">•</span>
		<span class="muted">{i18n.brand.tagline}</span>
		<span class="muted siteFooter__sep">•</span>
		<a class="siteFooter__link" href="/privacy">{i18n.footer.privacy}</a>
	</div>
</footer>

