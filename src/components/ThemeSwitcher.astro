---
import { ru as i18n } from '../i18n/ru';
import ThemeIcon from './ThemeIcon.astro';

import type { ThemeId } from './ThemeIcon.astro';

const THEMES: Array<{ id: ThemeId; label: string }> = [
	{ id: 'main', label: i18n.theme.options.main },
	{ id: 'cmyk', label: i18n.theme.options.cmyk },
	{ id: 'noir', label: i18n.theme.options.noir },
	{ id: 'kawaii', label: i18n.theme.options.kawaii },
];
---

<details class="theme-select" data-theme-switcher>
	<summary class="theme-select__trigger" aria-label={i18n.theme.ariaLabel}>
		<span class="theme-select__current">
			<span class="theme-select__currentIcon" aria-hidden="true">
				{THEMES.map((t) => (
					<span
						class="theme-select__swatch theme-select__currentIconItem"
						data-theme-current-icon={t.id}
						data-theme-swatch={t.id}
						hidden={t.id !== 'main'}
					>
						<ThemeIcon theme={t.id} size={40} />
					</span>
				))}
			</span>

			<span class="theme-select__currentLabel">
				{THEMES.map((t) => (
					<span
						class="theme-select__currentLabelItem"
						data-theme-current-label={t.id}
						hidden={t.id !== 'main'}
					>
						{t.label}
					</span>
				))}
			</span>
		</span>

		<svg class="theme-select__chevron" viewBox="0 0 24 24" aria-hidden="true">
			<path fill="currentColor" d="M7 10l5 5 5-5" />
		</svg>
	</summary>

	<div class="theme-select__panel" role="group" aria-label={i18n.theme.ariaLabel}>
		{THEMES.map((t) => (
			<button
				class="theme-select__option"
				type="button"
				data-theme={t.id}
				aria-label={t.label}
				aria-pressed="false"
			>
				<span class="theme-select__swatch" data-theme-swatch={t.id} aria-hidden="true">
					<ThemeIcon theme={t.id} size={40} />
				</span>
				<span class="theme-select__optionLabel">{t.label}</span>
			</button>
		))}
	</div>
</details>

<script is:inline>
	(() => {
		const STORAGE_KEY = 'mechprint.theme';
		const THEMES = new Set(['main', 'cmyk', 'noir', 'kawaii']);
		const MIGRATE = new Map([
			['neon', 'main'],
			['sakura', 'cmyk'],
			['motoko', 'main'],
			['anime', 'kawaii'],
			['cats', 'kawaii'],
		]);

		const root = document.documentElement;
		const scope = document.currentScript?.closest('[data-theme-switcher]') ?? document;
		const details = scope instanceof HTMLDetailsElement ? scope : null;

		const currentIcons = Array.from(scope.querySelectorAll('[data-theme-current-icon]')).filter(
			(el) => el instanceof HTMLElement
		);
		const currentLabels = Array.from(scope.querySelectorAll('[data-theme-current-label]')).filter(
			(el) => el instanceof HTMLElement
		);

		const buttons = Array.from(scope.querySelectorAll('button[data-theme]')).filter(
			(el) => el instanceof HTMLButtonElement
		);
		if (buttons.length === 0) return;

		const normalize = (value) => {
			if (!value) return null;
			if (THEMES.has(value)) return value;
			const migrated = MIGRATE.get(value);
			return migrated && THEMES.has(migrated) ? migrated : null;
		};

		const setActive = (next) => {
			for (const b of buttons) {
				const theme = b.getAttribute('data-theme');
				const pressed = theme === next;
				b.setAttribute('aria-pressed', pressed ? 'true' : 'false');
			}
		};

		const setCurrent = (next) => {
			for (const el of currentIcons) {
				const theme = el.getAttribute('data-theme-current-icon');
				const isActive = theme === next;
				el.toggleAttribute('hidden', !isActive);
			}
			for (const el of currentLabels) {
				const theme = el.getAttribute('data-theme-current-label');
				const isActive = theme === next;
				el.toggleAttribute('hidden', !isActive);
			}
		};

		const saved = normalize(localStorage.getItem(STORAGE_KEY));
		const initial = normalize(root.dataset.theme) || saved || 'main';
		root.dataset.theme = initial;
		setActive(initial);
		setCurrent(initial);

		for (const b of buttons) {
			b.addEventListener('click', () => {
				const next = normalize(b.getAttribute('data-theme'));
				if (!next) return;
				root.dataset.theme = next;
				setActive(next);
				setCurrent(next);
				localStorage.setItem(STORAGE_KEY, next);
				if (details) details.open = false;
			});
		}

		if (details) {
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') details.open = false;
			});
			document.addEventListener('click', (e) => {
				if (!details.open) return;
				const target = e.target instanceof Node ? e.target : null;
				if (target && !details.contains(target)) details.open = false;
			});
		}
	})();
</script>

<style>
	.theme-select {
		position: relative;
	}

	/* Важно: у нас у свотча задан display, и он перебивает UA-правило [hidden].
	   Поэтому принудительно скрываем элементы с hidden. */
	.theme-select [hidden] {
		display: none !important;
	}

	.theme-select__trigger {
		height: 46px;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		padding: 8px 12px;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		cursor: pointer;
		user-select: none;
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.2);
	}

	.theme-select__trigger::-webkit-details-marker {
		display: none;
	}

	.theme-select__trigger::marker {
		content: '';
	}

	.theme-select__current {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
	}

	.theme-select__currentIcon {
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		position: relative;
	}

	.theme-select__currentIcon .theme-select__currentIconItem {
		grid-area: 1 / 1;
	}

	.theme-select__currentLabel {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		font-size: 14px;
		line-height: 1;
		letter-spacing: 0.2px;
		white-space: nowrap;
	}

	.theme-select__chevron {
		width: 18px;
		height: 18px;
		opacity: 0.7;
	}

	.theme-select[open] .theme-select__chevron {
		transform: rotate(180deg);
	}

	.theme-select__panel {
		position: absolute;
		top: calc(100% + 10px);
		right: 0;
		min-width: 220px;
		padding: 10px;
		/* максимально “мягкая” форма */
		border-radius: calc(var(--radius-3) + 10px);
		border: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-bg) 78%, transparent);
		backdrop-filter: blur(10px);
		box-shadow: var(--shadow-2);
		display: grid;
		gap: 8px;
		z-index: 50;
	}

	.theme-select__option {
		width: 100%;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 10px;
		/* “пилюля” — почти круг */
		border-radius: 999px;
		border: 1px solid transparent;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
		text-align: left;
	}

	.theme-select__option:hover {
		background: color-mix(in srgb, var(--color-surface-2) 80%, transparent);
	}

	.theme-select__option[aria-pressed='true'] {
		border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
		background: color-mix(in srgb, var(--color-surface-2) 85%, transparent);
	}

	.theme-select__swatch {
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		border: 0;
		box-shadow: none;
		position: relative;
		border-radius: 18px;
		overflow: hidden;
		background: transparent;
	}

	.theme-select__swatch .theme-icon {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: 0;
		object-fit: contain;
		object-position: 50% 50%;
		opacity: 0.98;
		filter: none;
	}

	/* Light themes: keep swatch “paper” and softer shadow */
	html[data-theme='cmyk'] .theme-select__swatch,
	html[data-theme='kawaii'] .theme-select__swatch {
		background: transparent;
		box-shadow: none;
	}

	.theme-select__optionLabel {
		font-size: 14px;
		line-height: 1.2;
	}

	.theme-select__trigger:focus-visible,
	.theme-select__option:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 3px;
	}

	@media (max-width: 520px) {
		.theme-select__panel {
			right: 0;
			min-width: min(260px, calc(100vw - 24px));
		}
	}

	/* Desktop: фиксируем ширину, чтобы центр навигации не прыгал от длины названия */
	@media (min-width: 900px) {
		.theme-select__trigger {
			inline-size: 220px;
		}
	}
</style>

